set -euo pipefail

port=${PAULA_SOUND_PORT:-4713}
host=${PAULA_SOUND_HOST:-127.0.0.1}
server=tcp:$host:$port

usage() {
    cat <<'USAGE'
Usage: paula-sound [paula arguments...]

Starts Paula Escobar here and plays it out of the machine you are sitting
at, through the tunnel that machine opens when it ssh's in. Nothing
listens on the network at either end. When a piece is missing, the script
says what to run where.

Environment:
    PAULA_SOUND_PORT   both ends of the tunnel (default 4713)
    PAULA_SOUND_HOST   reach the sound server here instead of through the
                       tunnel
USAGE
}

die() {
    echo "paula-sound: $*" >&2
    exit 1
}

case ${1-} in
    -h|--help) usage; exit 0 ;;
esac

no_tunnel() {
    cat <<MESSAGE
nothing is answering on $server, so the tunnel is not open.

Connect from the machine you want to hear the music on like this:

    ssh -R $port:127.0.0.1:$port $(hostname)

or put it in that machine's ~/.ssh/config, once and for all:

    Host $(hostname)
        RemoteForward $port 127.0.0.1:$port

An ssh already holding the port keeps the new one from binding it; ssh
says so when it happens, and the older session still carries the sound.
MESSAGE
}

no_server() {
    cat <<MESSAGE
the tunnel to $server is open, but no sound server answers at the far end.

Run this on the machine you are listening from:

    pactl load-module module-native-protocol-tcp listen=127.0.0.1

It listens on that machine's loopback only, where nothing but the tunnel
reaches it. To keep it across reboots, put this in
~/.config/pipewire/pipewire-pulse.conf.d/10-tcp.conf there and restart
with 'systemctl --user restart pipewire pipewire-pulse wireplumber':

    pulse.cmd = [
        { cmd = "load-module"
          args = "module-native-protocol-tcp listen=127.0.0.1" }
    ]
MESSAGE
}

timeout 3 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null || die "$(no_tunnel)"
PULSE_SERVER=$server timeout 5 pactl info >/dev/null 2>&1 || die "$(no_server)"

for argument in "$@"; do
    case $argument in
        -o|-o?*|--output|--output=*) backend_chosen=true ;;
    esac
done
if [ -z "${backend_chosen-}" ] && command -v pacat >/dev/null; then
    set -- --output PULSE "$@"
fi

paula=$(command -v paula || true)
[ -n "$paula" ] || paula=$(dirname "$(readlink -f "$0")")/../target/paula
[ -x "$paula" ] || die "no paula executable found on PATH or in target/"

export PULSE_SERVER=$server
exec "$paula" "$@"
