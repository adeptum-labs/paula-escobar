+					sample = aktMemo.currentSample = aktMemo.assignedSample;
+					looped = (sample.loopType&ModConstants.LOOP_ON)!=0;
+					aktMemo.currentSamplePos = sample.loopStart;
+				}
+				else
+				if (looped)
