set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: paula-ssh [-s|--shell] <host> [paula arguments...]

Runs Paula Escobar over ssh on <host> and plays it out of the speakers here.
The local sound server's socket is forwarded into the session, so the remote
Paula writes its audio back to this machine.

  -s, --shell   open a login shell with the sound wired up, instead of paula
USAGE
}

shell_only=false
case ${1-} in
    -s|--shell) shell_only=true; shift ;;
    -h|--help) usage; exit 0 ;;
esac

if [ $# -lt 1 ]; then
    usage >&2
    exit 2
fi

host=$1
shift

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
pulse_socket=${PULSE_RUNTIME_PATH:-$runtime/pulse}/native
pipewire_name=${PIPEWIRE_REMOTE:-pipewire-0}
case $pipewire_name in
    /*) pipewire_socket=$pipewire_name ;;
    *) pipewire_socket=${PIPEWIRE_RUNTIME_DIR:-$runtime}/$pipewire_name ;;
esac

# A fresh name every run: sshd refuses to bind over a socket left behind by an
# earlier session unless the server sets StreamLocalBindUnlink.
tag=$(id -un)-$$-${RANDOM}
forwards=()
remote_sockets=()
remote_env=(COLORTERM="${COLORTERM:-truecolor}")

forward() {
    local remote=/tmp/paula-$1-$tag
    forwards+=(-R "$remote:$2")
    remote_sockets+=("$remote")
    remote_env+=("$3$remote")
}

[ -S "$pulse_socket" ] && forward pulse "$pulse_socket" PULSE_SERVER=unix:
[ -S "$pipewire_socket" ] && forward pipewire "$pipewire_socket" PIPEWIRE_REMOTE=

if [ ${#forwards[@]} -eq 0 ]; then
    echo "paula-ssh: no sound server socket here (looked for $pulse_socket and $pipewire_socket)" >&2
    exit 1
fi

if $shell_only; then
    remote_command="exec \$SHELL -l"
else
    remote_command="exec paula${*:+ $(printf '%q ' "$@")}"
fi

exec ssh -t -o ExitOnForwardFailure=yes "${forwards[@]}" "$host" \
    "trap 'rm -f ${remote_sockets[*]}' EXIT; export ${remote_env[*]}; $remote_command"
